POSTGRES_USER=cupcake
POSTGRES_PASSWORD=cupcake_secret
POSTGRES_DB=cupcake_gourmet
POSTGRES_PORT=5432

DATABASE_URL="postgresql://cupcake:cupcake_secret@localhost:5432/cupcake_gourmet?schema=public"

# =============================================================================
# Autenticação (next-auth v5)
# =============================================================================
AUTH_SECRET="gere-uma-chave-segura-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# =============================================================================
# Aplicação
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
